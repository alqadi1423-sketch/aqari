{
  "expo": {
    "name": "عقاري",
    "slug": "aqari",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aqari",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F6F4EE",
    "primaryColor": "#1E6E5C",
    "ios": {
      "bundleIdentifier": "com.rekaz.aqari",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.rekaz.aqari",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#144639"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1E6E5C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق الوصول للصور لإرفاق صور العقارات والمستندات"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#144639"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "icon": "./assets/icon.png"
  }
}
