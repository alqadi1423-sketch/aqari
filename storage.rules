rules_version = '2';

// قواعد ملفات عقاري في Firebase Storage (النموذج المختلط · قرار المالك ٢٠٢٦-١٠-٠٧) · src/cloud/storage.ts
//  · المسار orgs/{org}/files/{بصمة}.{امتداد} · ورقم المنشأة uid مالكها كما في firestore.rules.
//  · الملف يحمل رموز رؤيته في metadata.g («قسم|عقار» مفصولة بفواصل) كصفّ مرفقه في Firestore،
//    فلا يقرؤه العضو إلا إن كان في رموزه (مستند عضويته) رمزٌ منها.
//  · الرفع: المالك، أو عضوٌ له «إدخال» في قسم العملية metadata.op · بحجمٍ أقصاه ٥٠ م.ب، واسمٍ هو بصمة وامتداد،
//    وmd5 الذي حسبه الجهاز يطابق ما حسبه الخادم.
//  · الرفع فوق ملفٍ قائم للمالك وحده (#19 · التحقق المستقل): العضو لا يكتب فوقه محتوىً ولا رموزاً، والمالك يصلح ملفاً
//    سبقه إليه عضوٌ بمحتوىً آخر.
//  · التعديل: للمالك، ولعضوٍ يقرأ الملف أصلاً (#19: من عرف البصمة لا يضمّ رمزه فيقرؤه)، ورموز الرؤية تزيد ولا تنقص،
//    ولا يضمّ العضو رمز «كل العقارات» (قسم|*) فيقرأ الملفَّ أعضاءُ عقارٍ آخر، ومحتوى الملف لا يتغير · والحذف للمالك وحده.
service firebase.storage {
  match /b/{bucket}/o {
    function memberDoc(org) {
      return /databases/(default)/documents/orgs/$(org)/members/$(request.auth.uid);
    }
    function isOwner(org) {
      return request.auth != null && request.auth.uid == org;
    }
    function isMember(org) {
      return request.auth != null && firestore.exists(memberDoc(org));
    }
    function lvl(org, s) {
      let p = firestore.get(memberDoc(org)).data.perm;
      return s is string && s in p ? p[s] : 0;
    }
    // رموز «كل العقارات» لكل قسم · لا تمرّ القواعد على قائمة، فهي ثابتة هنا، واختبار storageRulesTokens يطابقها بالأقسام
    function orgWideTokens() {
      return ['props|*', 'contracts|*', 'tenants|*', 'collect|*', 'deposits|*', 'reservations|*', 'claims|*', 'invoices|*', 'purchases|*', 'maintenance|*', 'handover|*', 'banks|*', 'ledger|*', 'reports|*', 'library|*', 'company|*', 'audit|*', 'assets|*', 'admin|*'];
    }
    // رمزٌ يضيفه العضو إلى ملف (المراجعات الخارجية «ثالثاً أ ١» · قرار المالك 2026-10-09): قسمٌ له فيه «إدخال» فأعلى، وعقارٌ
    // من عقاراته (أو كلها له)، أو «@» لقرّاء كل العقارات في قسمٍ يكتب فيه (مرفقه في قسمه يحمله) · ولا «*» ولا قسمٌ غير معروف
    function tokOk(org, t) {
      let m = firestore.get(memberDoc(org)).data;
      let parts = t.split('[|]');
      return parts.size() == 2 && lvl(org, parts[0]) >= 2
        && (parts[1] == '@' || (parts[1] != '*' && (m.all == true || parts[1] in m.props)));
    }
    // لا تمرّ القواعد على قائمة · فالمضاف ستة رموز على الأكثر في التعديل الواحد، ويُفحص كلٌّ بموضعه (والعميل يضيفها دفعاتٍ)
    function addedOk(org, added) {
      return added.size() <= 6
        && (added.size() < 1 || tokOk(org, added[0])) && (added.size() < 2 || tokOk(org, added[1]))
        && (added.size() < 3 || tokOk(org, added[2])) && (added.size() < 4 || tokOk(org, added[3]))
        && (added.size() < 5 || tokOk(org, added[4])) && (added.size() < 6 || tokOk(org, added[5]));
    }
    function tokens(md) {
      return md != null && 'g' in md && md.g is string ? md.g.split(',') : [];
    }
    // أو ربط مرفقٍ حقيقي (نص قرار المالك 2026-10-09: «أو يُحصر تعديل الرموز في المالك وربط مرفق حقيقي» · والمتحقق المستقل: قرّاء
    // المرفق من أقسامٍ لا يكتب فيها العضو كانوا لا يرونه): الرموز المضافة من رموز صفّ مرفقٍ لهذا الملف ببصمته (metadata.att) ·
    // وصفّ المرفق يكتبه العضو فلا يُوثق به وحده (المتحقق المستقل على 61cfcd4): أقسام الرموز من قرّاء جهته (attachmentGRegex في
    // rulesGen.ts، ويطابقها اختبار storageRulesTokens)، وعقاراتها من عقارات العضو أو «@» · و«*» لملف مكتبةٍ جديد وحده
    function attRow(org, md) {
      return firestore.get(/databases/(default)/documents/orgs/$(org)/rows/$('attachments__' + md.att)).data;
    }
    function attSectionsRx() {
      return 'contract:(,(library|contracts|collect|deposits|reservations|claims|tenants|handover|reports|ledger|invoices)[|][^,]+)*,|unit:(,(library|props|contracts|tenants|collect|deposits|reservations|claims|invoices|purchases|maintenance|handover|banks|ledger|reports|assets)[|][^,]+)*,|property:(,(library|props|contracts|tenants|collect|deposits|reservations|claims|invoices|purchases|maintenance|handover|banks|ledger|reports|assets)[|][^,]+)*,|tenant:(,(library|tenants|contracts|collect|deposits|reservations|claims|handover|invoices)[|][^,]+)*,|occupant:(,(library|contracts|handover)[|][^,]+)*,|purchase:(,(library|purchases|reports|ledger|banks)[|][^,]+)*,|supplier:(,(library|purchases|ledger|reports|banks)[|][^,]+)*,|invoice:(,(library|invoices|reports|ledger)[|][^,]+)*,|claim:(,(library|claims|contracts|deposits|reports|ledger)[|][^,]+)*,|handover:(,(library|handover|contracts)[|][^,]+)*,|payment:(,(library|collect|contracts|reports|ledger)[|][^,]+)*,|reservation:(,(library|reservations|contracts|props|reports|ledger)[|][^,]+)*,|bank:(,(library|banks|collect|purchases|reservations|deposits|claims|ledger|reports)[|][^,]+)*,|bank_tx:(,(library|banks|reports|ledger)[|][^,]+)*,|company:(,(library|company)[|][^,]+)*,|company_doc:(,(library|company)[|][^,]+)*,|asset:(,(library|assets|props|maintenance|handover|ledger|reports|purchases)[|][^,]+)*,|[^:]*:(,library[|][^,]+)*,';
    }
    function attKnownRx() {
      return 'contract|unit|property|tenant|occupant|purchase|supplier|invoice|claim|handover|payment|reservation|bank|bank_tx|company|company_doc|asset';
    }
    function linkPropsOk(org, added) {
      let m = firestore.get(memberDoc(org)).data;
      let flat = ',' + added.join(',') + ',';
      return m.all == true ? !flat.matches('.*[|][*],.*')
        : m.props.join(',').matches('[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*')
          && flat.matches('(,[a-z]+[|](' + m.props.join('|') + '|@))+,');
    }
    function linkedOk(org, md, name, added, isNew) {
      let a = attRow(org, md);
      let et = string(a.d.get('entity_type', ''));
      return md != null && 'att' in md && md.att is string && md.att.matches('^[A-Za-z0-9_-]{1,64}$')
        && a.del != true && a.d.sha256 == name.split('[.]')[0]
        && added.hasOnly(a.g)
        && et.matches('[a-z_]*') && (et + ':,' + added.join(',') + ',').matches(attSectionsRx())
        && (linkPropsOk(org, added)
          // ملف مكتبةٍ جديد (بلا جهةٍ معروفة) برموز المكتبة «*» و«@» وحدها
          || (isNew && !et.matches(attKnownRx()) && added.hasOnly(['library|*', 'library|@'])));
    }

    match /orgs/{org}/files/{name} {
      // السؤال عن ملفٍ غير موجود يعيد «غير موجود» للعضو (لا يكشف شيئاً) · فيعرف الطابور أن عليه رفعه
      allow get: if isOwner(org)
        || (isMember(org) && (resource == null || tokens(resource.metadata).hasAny(firestore.get(memberDoc(org)).data.tokens)));
      allow create: if (isOwner(org) || (resource == null && isMember(org) && 'op' in request.resource.metadata && lvl(org, request.resource.metadata.op) >= 2
          && ((!tokens(request.resource.metadata).hasAny(orgWideTokens()) && addedOk(org, tokens(request.resource.metadata)))
            || linkedOk(org, request.resource.metadata, name, tokens(request.resource.metadata), true))))
        && request.resource.size < 50 * 1024 * 1024
        && name.matches('^[0-9a-f]{64}[.][a-z0-9]{1,5}$')
        && request.resource.metadata.md5 == request.resource.md5Hash;
      allow update: if (isOwner(org)
          && request.resource.size < 50 * 1024 * 1024
          && request.resource.metadata.md5 == request.resource.md5Hash)
        || (isMember(org) && tokens(resource.metadata).hasAny(firestore.get(memberDoc(org)).data.tokens)
          && request.resource.md5Hash == resource.md5Hash
          && request.resource.metadata.md5 == resource.metadata.md5
          && tokens(request.resource.metadata).hasAll(tokens(resource.metadata))
          && ((!tokens(request.resource.metadata).removeAll(tokens(resource.metadata)).hasAny(orgWideTokens())
              && addedOk(org, tokens(request.resource.metadata).removeAll(tokens(resource.metadata))))
            // والربط لا يوسّع ملفاً قائماً إلى «كل العقارات» (المتحقق المستقل على 61cfcd4)
            || (!tokens(request.resource.metadata).removeAll(tokens(resource.metadata)).hasAny(orgWideTokens())
              && linkedOk(org, request.resource.metadata, name, tokens(request.resource.metadata).removeAll(tokens(resource.metadata)), false))));
      allow delete: if isOwner(org);
    }

    // قائمة الملفات للمالك وحده · للمسح الشامل وحذف الحساب
    match /orgs/{org}/files {
      allow list: if isOwner(org);
    }
    match /orgs/{org}/{rest=**} {
      allow list: if isOwner(org);
    }
  }
}
