rules_version = '2';

// قواعد أمان عقاري · مساران للبيانات:
//  · users/{uid}: المسار الأقدم، لصاحبه وحده يقرؤه ويكتبه.
//  · orgs/{org}: المنشأة، ورقمها uid مالكها. المالك يقرأ ويكتب كل شيء، والعضو بمستند عضويته في
//    members/{uid} الذي ينشئه مرة من دعوته في invites/{email}. يقرأ العضو الصف إن كان في رموز رؤيته g
//    رمزٌ من رموزه، ويكتب بمستوى قسم العملية op وضمن عقاراته pids، و by كاتب المسودة لا يتغيّر.
//    وفي meta: عدّاد الترقيم (counters) وحروف الأجهزة القديمة (devices) وعهد المسح (epoch) ونقل الوحدات
//    (moves) وطلب الحذف (deletion).
// وفي المسارين ما لا يُعدَّل أصلاً: القيد المرحّل وسجل العمليات إضافةٌ فقط، ولا حذف لصف (الحذف شاهدٌ
// بـ del = true) إلا في ساعة بعد طلبٍ يكتبه صاحب البيانات بوقت الخادم، والمبالغ أعداد صحيحة بالهللات.
// قسم المنشأة بين علامتي org:generated مولَّد من src/domain/access/rulesGen.ts ولا يُعدَّل باليد.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // الجداول التي يزامنها التطبيق وحدها (src/db/syncTables.ts) · لا journal_lines بينها:
    // سطور القيد لا صفوف مستقلة لها، تسافر في حقل lines داخل مستند قيدها وتُحمى بحمايته
    function syncedTable(t) {
      return t in [
        'accounts', 'tenants', 'suppliers', 'banks', 'properties', 'property_areas',
        'property_area_items', 'property_floor_categories', 'units', 'unit_rooms', 'unit_room_items', 'meters',
        'meter_readings', 'company', 'company_docs', 'message_scripts', 'form_templates', 'journal_entries',
        'contracts', 'contract_installments', 'contract_occupants', 'occupants', 'reservations', 'key_money_deals',
        'contract_payments', 'payment_lines', 'payment_allocations', 'deposit_settlements', 'tenant_ratings', 'claims',
        'invoices', 'invoice_lines', 'purchases', 'bank_tx', 'handovers', 'blobs', 'attachments', 'cost_centers',
        'purchase_lines', 'assets', 'asset_events', 'depreciation_runs', 'audit_log'
      ];
    }

    // سطور القيد في مستند القيد وحده · ولا يحمل lines مستندٌ لغير قيد
    function linesOnlyOnEntries(r) {
      return !('lines' in r) || (r.t == 'journal_entries' && r.lines is list);
    }

    // شكل مستند الصف: جدول مزامَن، والجدول والمفتاح يطابقان معرّفه، والحقول المعروفة وحدها
    function validRow(rowId) {
      let r = request.resource.data;
      return r.keys().hasOnly(['t', 'k', 'd', 'lines', 'u', 'dev', 'del', 'ts'])
        && r.t is string && syncedTable(r.t) && linesOnlyOnEntries(r)
        && r.k is string && rowId == r.t + '__' + r.k
        && r.u is string && r.dev is string && r.del is bool
        && r.ts == request.time
        && (r.del == true || r.d is map)
        && amountsAreIntegers(r);
    }

    // المبالغ بالهللات أعداد صحيحة في كل عمود مالي بالقاعدة · وسطور القيد داخل lines لا تبلغها
    // القواعد (لا تمرّ على القوائم)، فيفحصها الجهاز عند الاستقبال بفحص الاستعادة نفسه
    function intOrAbsent(m, f) {
      return !(f in m) || m[f] == null || m[f] is int;
    }
    // مبالغ الصف أعداد صحيحة · بأعمدة جدوله وحده (حدّ الألف تعبير في الطلب الواحد) · والإسقاط بلا مبالغ
    function amountsAreIntegers(r) {
      return r.del == true || !(r.t in ['accounts', 'assets', 'bank_tx', 'banks', 'claims', 'contract_installments', 'contract_payments', 'contracts', 'deposit_settlements', 'invoice_lines', 'invoices', 'key_money_deals', 'meter_readings', 'payment_allocations', 'payment_lines', 'properties', 'purchase_lines', 'purchases', 'reservations', 'suppliers', 'tenants', 'units'])
        || (r.t == 'accounts' && intOrAbsent(r.d, 'opening_halalas'))
        || (r.t == 'assets' && intOrAbsent(r.d, 'cost_halalas') && intOrAbsent(r.d, 'salvage_halalas') && intOrAbsent(r.d, 'sale_halalas'))
        || (r.t == 'bank_tx' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'banks' && intOrAbsent(r.d, 'opening_halalas'))
        || (r.t == 'claims' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'contract_installments' && intOrAbsent(r.d, 'amount_halalas') && intOrAbsent(r.d, 'paid_halalas'))
        || (r.t == 'contract_payments' && intOrAbsent(r.d, 'gross_halalas') && intOrAbsent(r.d, 'discount_halalas') && intOrAbsent(r.d, 'net_halalas'))
        || (r.t == 'contracts' && intOrAbsent(r.d, 'value_halalas') && intOrAbsent(r.d, 'deposit_halalas') && intOrAbsent(r.d, 'cancel_deduction_halalas') && intOrAbsent(r.d, 'cancel_refund_halalas') && intOrAbsent(r.d, 'services_halalas') && intOrAbsent(r.d, 'parking_halalas'))
        || (r.t == 'deposit_settlements' && intOrAbsent(r.d, 'deduction_halalas') && intOrAbsent(r.d, 'refund_halalas'))
        || (r.t == 'invoice_lines' && intOrAbsent(r.d, 'price_halalas'))
        || (r.t == 'invoices' && intOrAbsent(r.d, 'subtotal_halalas') && intOrAbsent(r.d, 'tax_halalas') && intOrAbsent(r.d, 'total_halalas'))
        || (r.t == 'key_money_deals' && intOrAbsent(r.d, 'amount_halalas') && intOrAbsent(r.d, 'commission_halalas'))
        || (r.t == 'meter_readings' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'payment_allocations' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'payment_lines' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'properties' && intOrAbsent(r.d, 'lease_value_halalas'))
        || (r.t == 'purchase_lines' && intOrAbsent(r.d, 'amount_halalas'))
        || (r.t == 'purchases' && intOrAbsent(r.d, 'subtotal_halalas') && intOrAbsent(r.d, 'tax_halalas') && intOrAbsent(r.d, 'total_halalas'))
        || (r.t == 'reservations' && intOrAbsent(r.d, 'deposit_halalas'))
        || (r.t == 'suppliers' && intOrAbsent(r.d, 'default_amount_halalas'))
        || (r.t == 'tenants' && intOrAbsent(r.d, 'credit_halalas'))
        || (r.t == 'units' && intOrAbsent(r.d, 'rent_monthly_halalas'));
    }

    function isPostedEntry(data) {
      return data.t == 'journal_entries' && data.d != null && data.d.status == 'مرحّل';
    }

    // التعديل الوحيد المسموح على قيد مرحّل: ربطه بقيده العكسي مرة واحدة · لا غير
    function onlyLinksReversal() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['d', 'u', 'dev', 'ts'])
        && after.d.diff(before.d).affectedKeys().hasOnly(['reversed_by'])
        && (!('reversed_by' in before.d) || before.d.reversed_by == null)
        && after.d.reversed_by is string;
    }

    // «حذف حسابي» بطلب صاحبه وحده: يكتب meta/deletion بوقت الخادم، ولساعةٍ بعده فقط يحذف صفوفه كلها ·
    // وبلا هذا الطلب لا يُحذف صفٌّ أبداً كما كان (القيد المرحّل وسجل العمليات خاصةً)
    function deletionOpen(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/meta/deletion;
      return exists(p) && request.time < get(p).data.at + duration.value(1, 'h');
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meta/deletion {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      }

      match /rows/{rowId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validRow(rowId);
        allow update: if isOwner(uid) && validRow(rowId)
          && resource.data.t != 'audit_log'
          && (!isPostedEntry(resource.data) || onlyLinksReversal());
        allow delete: if isOwner(uid) && deletionOpen(uid);
      }

      // ما سوى الصفوف (حالة المزامنة مثلاً) لصاحبه وحده
      match /{other}/{docId} {
        allow read: if isOwner(uid) && other != 'rows';
        // طلب الحذف لا يُكتب من هنا · له قاعدته بوقت الخادم أعلاه
        allow write: if isOwner(uid) && other != 'rows' && !(other == 'meta' && docId == 'deletion');
      }
    }

    // <org:generated> · لا تُعدَّل باليد: src/domain/access/rulesGen.ts
    // صلاحيات الأقسام: المالك (uid == org) يقرأ ويكتب كل شيء بقيود الصف نفسها، والعضو بمستند عضويته
    function orgOwner(org) {
      return request.auth != null && request.auth.uid == org;
    }
    function memberPath(org) {
      return /databases/$(database)/documents/orgs/$(org)/members/$(request.auth.uid);
    }
    function isMember(org) {
      return request.auth != null && exists(memberPath(org));
    }
    function mem(org) {
      return get(memberPath(org)).data;
    }
    function lvl(org, s) {
      return s is string && s in mem(org).perm ? mem(org).perm[s] : 0;
    }
    // الجدول الأصل لمستند الإسقاط (contracts~pub ← contracts)
    function baseT(t) {
      return t.split('~')[0];
    }
    function syncedOrPub(t) {
      return syncedTable(baseT(t)) && (t == baseT(t) || t == baseT(t) + '~pub');
    }
    function isDraft(data) {
      return data.d != null && (
        (baseT(data.t) == 'contracts' && data.d.status == 'مسودة')
        || (data.t == 'invoices' && data.d.status == 'مسودة')
        || (data.t == 'journal_entries' && data.d.status == 'قيد الإنشاء'));
    }
    // عقارات الصف ضمن عقارات العضو · والصف العام '*' مسموح لمن له القسم
    function propsOk(org, r) {
      return mem(org).all == true || r.pids.hasOnly(mem(org).props.concat(['*']));
    }
    // الحقل الجانبي في صفٍّ مشترك (رصيد مستأجرٍ له عقد في عقار آخر): يكفي أن يمسّ الصف عقاراً للعضو
    // وألا تتغيّر عقاراته
    function propsTouch(org, before, after) {
      return mem(org).all == true
        || (after.pids == before.pids && after.pids.hasAny(mem(org).props.concat(['*'])));
    }

    // ما ينشئه كل قسم (create + own في OP_WRITES)
    function opCreates(op, t) {
      return (op == 'props' && t in ['audit_log', 'blobs', 'attachments', 'properties', 'property_areas', 'property_area_items', 'property_floor_categories', 'units', 'unit_rooms', 'unit_room_items', 'meters'])
        || (op == 'maintenance' && t in ['audit_log'])
        || (op == 'contracts' && t in ['journal_entries', 'audit_log', 'tenants', 'handovers', 'claims', 'bank_tx', 'contract_payments', 'blobs', 'attachments', 'contracts', 'contract_installments', 'contract_occupants', 'occupants', 'tenant_ratings'])
        || (op == 'tenants' && t in ['audit_log', 'blobs', 'attachments', 'tenants'])
        || (op == 'collect' && t in ['journal_entries', 'audit_log', 'bank_tx', 'blobs', 'attachments', 'contract_payments', 'payment_lines', 'payment_allocations'])
        || (op == 'deposits' && t in ['journal_entries', 'audit_log', 'bank_tx', 'claims', 'blobs', 'attachments', 'deposit_settlements'])
        || (op == 'reservations' && t in ['journal_entries', 'audit_log', 'bank_tx', 'blobs', 'attachments', 'reservations', 'key_money_deals'])
        || (op == 'claims' && t in ['journal_entries', 'audit_log', 'bank_tx', 'blobs', 'attachments', 'claims'])
        || (op == 'invoices' && t in ['journal_entries', 'audit_log', 'bank_tx', 'blobs', 'attachments', 'invoices', 'invoice_lines'])
        || (op == 'purchases' && t in ['journal_entries', 'audit_log', 'bank_tx', 'assets', 'asset_events', 'blobs', 'attachments', 'suppliers', 'purchases', 'meter_readings', 'purchase_lines'])
        || (op == 'handover' && t in ['audit_log', 'blobs', 'attachments', 'handovers'])
        || (op == 'banks' && t in ['journal_entries', 'audit_log', 'blobs', 'attachments', 'banks', 'bank_tx'])
        || (op == 'ledger' && t in ['audit_log', 'journal_entries', 'accounts', 'cost_centers'])
        || (op == 'library' && t in ['audit_log', 'blobs', 'attachments'])
        || (op == 'assets' && t in ['journal_entries', 'audit_log', 'bank_tx', 'purchase_lines', 'blobs', 'attachments', 'assets', 'asset_events', 'depreciation_runs'])
        || (op == 'company' && t in ['audit_log', 'blobs', 'attachments', 'company', 'company_docs', 'message_scripts', 'form_templates'])
        || (op == 'reports' && t in ['audit_log']);
    }
    // جداول القسم نفسه · تعديلها وحذفها بكامل
    function opOwns(op, t) {
      return (op == 'props' && t in ['properties', 'property_areas', 'property_area_items', 'property_floor_categories', 'units', 'unit_rooms', 'unit_room_items', 'meters'])
        || (op == 'contracts' && t in ['contracts', 'contract_installments', 'contract_occupants', 'occupants', 'tenant_ratings'])
        || (op == 'tenants' && t in ['tenants'])
        || (op == 'collect' && t in ['contract_payments', 'payment_lines', 'payment_allocations'])
        || (op == 'deposits' && t in ['deposit_settlements'])
        || (op == 'reservations' && t in ['reservations', 'key_money_deals'])
        || (op == 'claims' && t in ['claims'])
        || (op == 'invoices' && t in ['invoices', 'invoice_lines'])
        || (op == 'purchases' && t in ['suppliers', 'purchases', 'meter_readings', 'purchase_lines'])
        || (op == 'handover' && t in ['handovers'])
        || (op == 'banks' && t in ['banks', 'bank_tx'])
        || (op == 'ledger' && t in ['journal_entries', 'accounts', 'cost_centers'])
        || (op == 'library' && t in ['attachments'])
        || (op == 'assets' && t in ['assets', 'asset_events', 'depreciation_runs'])
        || (op == 'company' && t in ['company', 'company_docs', 'message_scripts', 'form_templates']);
    }
    // حقولٌ بعينها في جداول أقسام أخرى تمسّها العملية جانبياً بإدخال
    function opTouches(op, t, keys) {
      return (t == 'attachments' && op in ['props', 'contracts', 'tenants', 'collect', 'deposits', 'reservations', 'claims', 'invoices', 'purchases', 'handover', 'banks', 'assets', 'company'] && keys.hasOnly(['display_name', 'note', 'cat_override', 'deleted_at', 'entity_type', 'entity_id', 'thumb']))
        || (op == 'maintenance' && t == 'units' && keys.hasOnly(['under_maintenance']))
        || (t == 'journal_entries' && op in ['contracts', 'collect', 'deposits', 'reservations', 'claims', 'invoices', 'purchases', 'banks', 'assets'] && keys.hasOnly(['reversed_by']))
        || (op == 'contracts' && t == 'reservations' && keys.hasOnly(['status', 'converted_contract_id', 'deposit_outcome', 'deposit_settled_date']))
        || (op == 'tenants' && t == 'contracts' && keys.hasOnly(['tenant_id', 'tenant_name']))
        || (op == 'collect' && t == 'contract_installments' && keys.hasOnly(['paid_halalas', 'status']))
        || (op == 'collect' && t == 'tenants' && keys.hasOnly(['credit_halalas']))
        || (op == 'purchases' && t == 'meters' && keys.hasOnly(['supplier_id']));
    }

    function validOrgRow(rowId) {
      let r = request.resource.data;
      return r.keys().hasOnly(['t', 'k', 'd', 'lines', 'u', 'dev', 'del', 'ts', 'op', 'g', 'pids', 'by'])
        && r.t is string && syncedOrPub(r.t) && (!('lines' in r) || (r.t == 'journal_entries' && r.lines is list))
        && r.k is string && rowId == r.t + '__' + r.k
        && r.u is string && r.dev is string && r.del is bool
        && r.ts == request.time
        && (r.del == true || r.d is map)
        && r.g is list && r.pids is list && r.pids.size() > 0
        && (!('by' in r) || r.by is string)
        && amountsAreIntegers(r);
    }

    function memberCreates(org) {
      let r = request.resource.data;
      return isMember(org) && r.op is string && (
        (lvl(org, r.op) >= 2 && opCreates(r.op, baseT(r.t)) && propsOk(org, r) && (!('by' in r) || r.by == request.auth.uid))
        // تعديل العضو بياناته يُسجَّل في سجل العمليات باسمه ولو لم يُجز له قسمٌ إدخالاً (توجيه المالك ٢٠٢٦-١٠-٠٥)
        || (r.op == 'self' && r.t == 'audit_log' && r.d != null && r.d.entity_type == 'بيانات عضو' && r.pids == ['*']));
    }

    // كامل في جدول القسم · أو مسودةُ كاتبها بإدخال (قرار المالك) · أو حقولٌ مجازة جانبياً بإدخال
    function memberUpdates(org) {
      let before = resource.data;
      let after = request.resource.data;
      let op = after.op;
      // يُحسبان مرة · سلسلة الجداول والمستوى تُعدّ في حدّ الألف تعبير للطلب
      let owns = op is string && opOwns(op, baseT(after.t));
      let level = op is string ? lvl(org, op) : 0;
      return isMember(org) && op is string
        && after.get('by', null) == before.get('by', null)
        && (
          (owns && level >= 3 && propsOk(org, after))
          || (owns && level >= 2 && isDraft(before)
              && before.get('by', '') == request.auth.uid && propsOk(org, after))
          || (!owns && level >= 2 && after.del == false && before.d != null && propsTouch(org, before, after)
              && opTouches(op, baseT(after.t), after.d.diff(before.d).affectedKeys()))
        );
    }

    // التعديل الوحيد على قيد مرحّل: ربطه بعاكسه مرة · وحقول الرؤية تُكتب مع كل كتابة
    function orgOnlyLinksReversal() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['d', 'u', 'dev', 'ts', 'op', 'g', 'pids'])
        && after.d.diff(before.d).affectedKeys().hasOnly(['reversed_by'])
        && (!('reversed_by' in before.d) || before.d.reversed_by == null)
        && after.d.reversed_by is string;
    }

    // وجهاز المالك يعيد كتابة حقول الرؤية وحدها على قيد مرحّل حين يتسع قرّاؤه (engine.requeueForAcl) · ومحتواه كما هو
    function orgOnlyVisibility() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['u', 'dev', 'ts', 'op', 'g', 'pids']);
    }

    // وجهاز المالك يملأ أبعاد سطور القيد المرحّل القديم (الهجرة ٢٨) · السطور بعددها وبكل حقولها كما هي إلا أبعادها
    function lineDimsOnly(a, b) {
      return a.diff(b).affectedKeys().hasOnly(['property_id', 'unit_id', 'contract_id', 'cost_center_id', 'asset_id']);
    }
    function orgOnlyLineDims() {
      let a = request.resource.data.lines;
      let b = resource.data.lines;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'u', 'dev', 'ts', 'op', 'g', 'pids'])
        && a.size() == b.size() && b.size() <= 24
        && (b.size() <= 0 || lineDimsOnly(a[0], b[0]))
        && (b.size() <= 1 || lineDimsOnly(a[1], b[1]))
        && (b.size() <= 2 || lineDimsOnly(a[2], b[2]))
        && (b.size() <= 3 || lineDimsOnly(a[3], b[3]))
        && (b.size() <= 4 || lineDimsOnly(a[4], b[4]))
        && (b.size() <= 5 || lineDimsOnly(a[5], b[5]))
        && (b.size() <= 6 || lineDimsOnly(a[6], b[6]))
        && (b.size() <= 7 || lineDimsOnly(a[7], b[7]))
        && (b.size() <= 8 || lineDimsOnly(a[8], b[8]))
        && (b.size() <= 9 || lineDimsOnly(a[9], b[9]))
        && (b.size() <= 10 || lineDimsOnly(a[10], b[10]))
        && (b.size() <= 11 || lineDimsOnly(a[11], b[11]))
        && (b.size() <= 12 || lineDimsOnly(a[12], b[12]))
        && (b.size() <= 13 || lineDimsOnly(a[13], b[13]))
        && (b.size() <= 14 || lineDimsOnly(a[14], b[14]))
        && (b.size() <= 15 || lineDimsOnly(a[15], b[15]))
        && (b.size() <= 16 || lineDimsOnly(a[16], b[16]))
        && (b.size() <= 17 || lineDimsOnly(a[17], b[17]))
        && (b.size() <= 18 || lineDimsOnly(a[18], b[18]))
        && (b.size() <= 19 || lineDimsOnly(a[19], b[19]))
        && (b.size() <= 20 || lineDimsOnly(a[20], b[20]))
        && (b.size() <= 21 || lineDimsOnly(a[21], b[21]))
        && (b.size() <= 22 || lineDimsOnly(a[22], b[22]))
        && (b.size() <= 23 || lineDimsOnly(a[23], b[23]));
    }

    // «حذف حسابي» للمالك: نافذة ساعة بطلبٍ بوقت الخادم كما في users/{uid}
    function orgDeletionOpen(org) {
      let p = /databases/$(database)/documents/orgs/$(org)/meta/deletion;
      return exists(p) && request.time < get(p).data.at + duration.value(1, 'h');
    }

    match /orgs/{org} {
      allow read, write: if orgOwner(org);

      match /rows/{rowId} {
        allow read: if orgOwner(org) || (isMember(org) && resource.data.g.hasAny(mem(org).tokens));
        allow create: if validOrgRow(rowId) && (orgOwner(org) || memberCreates(org));
        allow update: if validOrgRow(rowId)
          && resource.data.t != 'audit_log'
          && (!isPostedEntry(resource.data) || orgOnlyLinksReversal() || (orgOwner(org) && (orgOnlyVisibility() || orgOnlyLineDims())))
          && (orgOwner(org) || memberUpdates(org));
        allow delete: if orgOwner(org) && orgDeletionOpen(org);
      }

      // بيانات العضو (توجيه المالك ٢٠٢٦-١٠-٠٥): الجوال سعودي موحَّد والهوية عشرة أرقام أولها ١ أو ٢،
      // ويجوز تركها فارغة عند الدعوة ليكملها العضو · والهوية لا تُقرأ إلا من مستند العضوية (المالك والعضو وحدهما)
      function profileShape(d) {
        return (!('name' in d) || (d.name is string && d.name.size() <= 80))
          && (!('phone' in d) || (d.phone is string && (d.phone == '' || d.phone.matches('^05[0-9]{8}$'))))
          && (!('nid' in d) || (d.nid is string && (d.nid == '' || d.nid.matches('^[12][0-9]{9}$'))))
          && (!('title' in d) || (d.title is string && d.title.size() <= 60));
      }
      // ما يكمله العضو بنفسه: الاسم والجوال إلزاميان
      function profileComplete(d) {
        return profileShape(d) && d.name is string && d.name.size() >= 2 && d.phone is string && d.phone.matches('^05[0-9]{8}$');
      }

      // العضوية: يكتبها المالك · والعضو ينشئ عضويته مرة من دعوةٍ بإيميله وبنصّها حرفياً، ويعدّل بياناته وحدها،
      // ويغادر بحذفها
      match /members/{uid} {
        allow read: if orgOwner(org) || (request.auth != null && request.auth.uid == uid);
        allow create: if (orgOwner(org) && profileShape(request.resource.data)) || (
          request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/orgs/$(org)/invites/$(request.auth.token.email))
          && request.resource.data == get(/databases/$(database)/documents/orgs/$(org)/invites/$(request.auth.token.email)).data);
        allow update: if (orgOwner(org) && profileShape(request.resource.data)) || (
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'nid', 'title'])
          && profileComplete(request.resource.data));
        allow delete: if orgOwner(org) || (request.auth != null && request.auth.uid == uid);
      }

      match /invites/{email} {
        allow read: if orgOwner(org) || (request.auth != null && request.auth.token.email == email);
        // لا دعوة لإيميل المالك نفسه
        allow create, update: if orgOwner(org) && request.resource.data.email == email
          && email != request.auth.token.email && profileShape(request.resource.data);
        allow delete: if orgOwner(org) || (request.auth != null && request.auth.token.email == email);
      }

      // حروف الأجهزة في ترقيم المنشأة · العضو يضيف حرف جهازه ولا يغيّر حرفاً قائماً
      match /meta/devices {
        allow read: if orgOwner(org) || isMember(org);
        allow create: if orgOwner(org);
        allow update: if orgOwner(org) || (isMember(org)
          && request.resource.data.keys().hasOnly(['letters'])
          && request.resource.data.letters.diff(resource.data.letters).changedKeys().size() == 0
          && request.resource.data.letters.diff(resource.data.letters).removedKeys().size() == 0);
      }

      // عهد المسح: يرفعه المالك عند «مسح كل البيانات» فيفرّغ كل جهاز نسخته عند أول مزامنة
      match /meta/epoch {
        allow read: if orgOwner(org) || isMember(org);
        allow write: if orgOwner(org) && request.resource.data.keys().hasOnly(['n', 'at']) && request.resource.data.n is int;
      }

      // سجل نقل الوحدات بين العقارات · العضو يقرؤه ليعرف هل خرجت وحدةٌ من عقاراته
      match /meta/moves {
        allow read: if orgOwner(org) || isMember(org);
        allow write: if orgOwner(org) && request.resource.data.keys().hasOnly(['moves']) && request.resource.data.moves is list;
      }

      // عدّاد الترقيم (numbering.ts): آخر رقمٍ محجوز لكل سلسلة · يحجز منه المالك والعضو كتلاً، وتأخذ منه الفاتورة
      // الضريبية رقمها · ولا ينقص عددٌ ولا يُحذف أبداً، فلا يُعطى رقمٌ مرتين
      function counterOk(d, b, k) {
        return !(k in d) || (d[k] is int && d[k] >= 0 && (b == null || !(k in b) || d[k] >= b[k]));
      }
      function countersOk(d, b) {
        return d.keys().hasOnly(['JE', 'EJ', 'PUR', 'INV'])
          && counterOk(d, b, 'JE') && counterOk(d, b, 'EJ') && counterOk(d, b, 'PUR') && counterOk(d, b, 'INV')
          && (b == null || d.keys().hasAll(b.keys()));
      }
      match /meta/counters {
        allow read: if orgOwner(org) || isMember(org);
        allow create: if (orgOwner(org) || isMember(org)) && countersOk(request.resource.data, null);
        allow update: if (orgOwner(org) || isMember(org)) && countersOk(request.resource.data, resource.data);
      }

      match /meta/deletion {
        allow read, delete: if orgOwner(org);
        allow create, update: if orgOwner(org)
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      }
    }

    // العضو يجد دعوته بإيميله بين المنشآت
    match /{path=**}/invites/{email} {
      allow read: if request.auth != null && resource.data.email == request.auth.token.email;
    }
    // </org:generated>

    // <chat> · المحادثة (src/chat · قرار المالك 2026-10-07) · إضافة لا تغيّر قاعدة قائمة:
    // الأطراف وحدهم يقرؤون المحادثة ورسائلها · الرسالة تُنشأ مرة بوقت الخادم ولا تُعدَّل ولا تُحذف ·
    // والمجموعة ينشئها المالك أو مشرف قسم · والمرفقات (att) مغلقة حتى الفوترة
    function chatIn(org) {
      return request.auth != null && (orgOwner(org) || isMember(org));
    }
    function chatRolePath(org) {
      return /databases/$(database)/documents/orgs/$(org)/chatRoles/$(request.auth.token.email);
    }
    function chatSup(org) {
      return exists(chatRolePath(org)) ? get(chatRolePath(org)).data.sup : [];
    }
    function chatParty(org, chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/orgs/$(org)/chats/$(chatId)).data.p;
    }
    match /orgs/{org}/chatDir/{uid} {
      allow read: if chatIn(org);
      allow create, update: if chatIn(org) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'sup', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.sup == chatSup(org)
        && request.resource.data.at == request.time;
      allow delete: if orgOwner(org) || (request.auth != null && request.auth.uid == uid);
    }
    match /orgs/{org}/chatRoles/{email} {
      allow read: if chatIn(org);
      allow write: if orgOwner(org)
        && request.resource.data.keys().hasOnly(['sup'])
        && request.resource.data.sup is list && request.resource.data.sup.size() <= 30;
      allow delete: if orgOwner(org);
    }
    match /orgs/{org}/chats/{chatId} {
      allow read: if chatIn(org) && request.auth.uid in resource.data.p;
      allow create: if chatIn(org)
        && request.resource.data.keys().hasOnly(['k', 'p', 'name', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.p is list && request.auth.uid in request.resource.data.p
        && request.resource.data.p.size() >= 2 && request.resource.data.p.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && ((request.resource.data.k == 'direct' && request.resource.data.p.size() == 2
              && chatId == 'd_' + request.resource.data.p[0] + '_' + request.resource.data.p[1])
            || (request.resource.data.k == 'group' && chatId.matches('^g_[A-Za-z0-9_-]{6,64}$')
              && (orgOwner(org) || chatSup(org).size() > 0)));
      allow update, delete: if false;

      match /msgs/{msgId} {
        allow read: if chatIn(org) && chatParty(org, chatId);
        allow create: if chatIn(org) && chatParty(org, chatId)
          && request.resource.data.keys().hasOnly(['from', 'name', 'body', 'link', 'att', 'ts'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.body is string && request.resource.data.body.size() <= 4000
          && (request.resource.data.link == null || (request.resource.data.link is map
              && request.resource.data.link.keys().hasOnly(['type', 'id', 'label'])
              && request.resource.data.link.type in ['contract', 'unit', 'asset', 'maintenance']))
          && request.resource.data.att == null;
        allow update, delete: if false;
      }
    }
    // </chat>
  }
}
