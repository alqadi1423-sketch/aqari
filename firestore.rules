rules_version = '2';

// قواعد أمان عقاري · كل بيانات المستخدم تحت users/{uid} ولا يقرؤها ولا يكتبها إلا صاحبها.
// وفوق ذلك ما لا يُعدَّل أصلاً: القيد المرحّل وسجل العمليات إضافةٌ فقط، ولا حذف لأي صف
// (الحذف شاهدٌ بـ del = true على مستند المسودة)، والمبالغ أعداد صحيحة بالهللات.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // الجداول التي يزامنها التطبيق وحدها (src/db/syncTables.ts) · لا journal_lines بينها:
    // سطور القيد لا صفوف مستقلة لها، تسافر في حقل lines داخل مستند قيدها وتُحمى بحمايته
    function syncedTable(t) {
      return t in [
        'accounts', 'tenants', 'suppliers', 'banks', 'properties', 'property_areas',
        'property_area_items', 'property_floor_categories', 'units', 'unit_rooms', 'unit_room_items', 'meters',
        'meter_readings', 'company', 'company_docs', 'message_scripts', 'form_templates', 'journal_entries',
        'contracts', 'contract_installments', 'contract_occupants', 'occupants', 'reservations', 'key_money_deals',
        'contract_payments', 'payment_lines', 'payment_allocations', 'deposit_settlements', 'tenant_ratings', 'claims',
        'invoices', 'invoice_lines', 'purchases', 'bank_tx', 'handovers', 'audit_log'
      ];
    }

    // سطور القيد في مستند القيد وحده · ولا يحمل lines مستندٌ لغير قيد
    function linesOnlyOnEntries(r) {
      return !('lines' in r) || (r.t == 'journal_entries' && r.lines is list);
    }

    // شكل مستند الصف: جدول مزامَن، والجدول والمفتاح يطابقان معرّفه، والحقول المعروفة وحدها
    function validRow(rowId) {
      let r = request.resource.data;
      return r.keys().hasOnly(['t', 'k', 'd', 'lines', 'u', 'dev', 'del', 'ts'])
        && r.t is string && syncedTable(r.t) && linesOnlyOnEntries(r)
        && r.k is string && rowId == r.t + '__' + r.k
        && r.u is string && r.dev is string && r.del is bool
        && r.ts == request.time
        && (r.del == true || r.d is map)
        && amountsAreIntegers(r);
    }

    // المبالغ بالهللات أعداد صحيحة في كل عمود مالي بالقاعدة · وسطور القيد داخل lines لا تبلغها
    // القواعد (لا تمرّ على القوائم)، فيفحصها الجهاز عند الاستقبال بفحص الاستعادة نفسه
    function intOrAbsent(m, f) {
      return !(f in m) || m[f] == null || m[f] is int;
    }
    function amountsAreIntegers(r) {
      return r.del == true || (
        intOrAbsent(r.d, 'amount_halalas') && intOrAbsent(r.d, 'paid_halalas')
        && intOrAbsent(r.d, 'value_halalas') && intOrAbsent(r.d, 'deposit_halalas')
        && intOrAbsent(r.d, 'gross_halalas') && intOrAbsent(r.d, 'net_halalas')
        && intOrAbsent(r.d, 'discount_halalas') && intOrAbsent(r.d, 'total_halalas')
        && intOrAbsent(r.d, 'subtotal_halalas') && intOrAbsent(r.d, 'tax_halalas')
        && intOrAbsent(r.d, 'debit_halalas') && intOrAbsent(r.d, 'credit_halalas')
        && intOrAbsent(r.d, 'opening_halalas') && intOrAbsent(r.d, 'price_halalas')
        && intOrAbsent(r.d, 'commission_halalas') && intOrAbsent(r.d, 'deduction_halalas')
        && intOrAbsent(r.d, 'refund_halalas') && intOrAbsent(r.d, 'cancel_deduction_halalas')
        && intOrAbsent(r.d, 'cancel_refund_halalas') && intOrAbsent(r.d, 'lease_value_halalas')
        && intOrAbsent(r.d, 'default_amount_halalas') && intOrAbsent(r.d, 'rent_monthly_halalas'));
    }

    function isPostedEntry(data) {
      return data.t == 'journal_entries' && data.d != null && data.d.status == 'مرحّل';
    }

    // التعديل الوحيد المسموح على قيد مرحّل: ربطه بقيده العكسي مرة واحدة · لا غير
    function onlyLinksReversal() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['d', 'u', 'dev', 'ts'])
        && after.d.diff(before.d).affectedKeys().hasOnly(['reversed_by'])
        && (!('reversed_by' in before.d) || before.d.reversed_by == null)
        && after.d.reversed_by is string;
    }

    // «حذف حسابي» بطلب صاحبه وحده: يكتب meta/deletion بوقت الخادم، ولساعةٍ بعده فقط يحذف صفوفه كلها ·
    // وبلا هذا الطلب لا يُحذف صفٌّ أبداً كما كان (القيد المرحّل وسجل العمليات خاصةً)
    function deletionOpen(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/meta/deletion;
      return exists(p) && request.time < get(p).data.at + duration.value(1, 'h');
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meta/deletion {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      }

      match /rows/{rowId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validRow(rowId);
        allow update: if isOwner(uid) && validRow(rowId)
          && resource.data.t != 'audit_log'
          && (!isPostedEntry(resource.data) || onlyLinksReversal());
        allow delete: if isOwner(uid) && deletionOpen(uid);
      }

      // ما سوى الصفوف (حالة المزامنة مثلاً) لصاحبه وحده
      match /{other}/{docId} {
        allow read: if isOwner(uid) && other != 'rows';
        // طلب الحذف لا يُكتب من هنا · له قاعدته بوقت الخادم أعلاه
        allow write: if isOwner(uid) && other != 'rows' && !(other == 'meta' && docId == 'deletion');
      }
    }
  }
}
